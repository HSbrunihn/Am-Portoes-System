# Copie para .env (que NÃO vai para o Git) e preencha com valores reais.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/am_portoes
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha
SHOW_SQL=false

# Chave do JWT: Base64 de pelo menos 32 bytes aleatórios.
# Para gerar no PowerShell:
#   $b = New-Object byte[] 48
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_SECRET=gere-uma-chave-aleatoria
JWT_EXPIRATION_MINUTES=60

# CORS: URL(s) do Angular, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Administrador inicial (criado só se a senha estiver definida e o e-mail não existir)
ADMIN_EMAIL=admin@amportoes.com.br
ADMIN_PASSWORD=troque-esta-senha-forte